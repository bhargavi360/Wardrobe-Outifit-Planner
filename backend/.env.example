APP_NAME=Smart Wardrobe API
API_PREFIX=/api
MONGODB_URI=mongodb://localhost:27017
# Optional secondary database. Set this to your MongoDB Atlas connection URI
# to mirror local writes to Atlas and copy existing local data at API startup.
MONGODB_MIRROR_URI=
MONGODB_DATABASE=smart_wardrobe
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002"]
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=wardrobe_access_token
UPLOADS_DIR=uploads
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
