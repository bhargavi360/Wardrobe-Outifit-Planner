APP_NAME=Smart Wardrobe API
API_PREFIX=/api
# Atlas is primary. Replace the username, password, and cluster placeholders;
# remove template brackets and URL-encode special characters in credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>
# Optional local backup. Set to mongodb://localhost:27017 on your computer;
# leave unset on hosted services such as Render.
MONGODB_MIRROR_URI=
MONGODB_DATABASE=smart_wardrobe
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002"]
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=wardrobe_access_token
UPLOADS_DIR=uploads
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
